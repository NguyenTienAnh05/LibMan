<style>
body { font-family: Arial, Helvetica, sans-serif; background: #eef3f8; margin: 0; color: #222; }
.topbar { background: #2e75b6; color: #fff; padding: 10px 24px; display: flex; justify-content: space-between; align-items: center; }
.topbar a { color: #fff; margin-left: 14px; }
.topbar .brand { font-size: 18px; font-weight: bold; }
.container { max-width: 760px; margin: 24px auto; background: #fff; border: 1px solid #b7c9dc; border-radius: 6px; padding: 20px 28px; }
.container.narrow { max-width: 420px; }
h2 { text-align: center; margin-top: 0; }
.row { display: flex; align-items: center; margin: 10px 0; }
.row label { width: 150px; font-weight: bold; }
.row input[type=text], .row input[type=password] { flex: 1; padding: 6px 8px; border: 1px solid #99a; border-radius: 3px; }
.actions { text-align: center; margin-top: 18px; }
.btn, input[type=submit] { background: #e7e6e6; border: 1px solid #333; border-radius: 4px; padding: 7px 22px; cursor: pointer; font-size: 14px; text-decoration: none; color: #000; display: inline-block; }
.btn:hover, input[type=submit]:hover { background: #d4e3f3; }
table.data { width: 100%; border-collapse: collapse; margin-top: 12px; }
table.data th, table.data td { border: 1px solid #777; padding: 6px 8px; text-align: left; }
table.data th { background: #d9d9d9; }
table.data tr:hover td { background: #fff2cc; }
.error { background: #fde9e7; border: 1px solid #d9534f; color: #a94442; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px; }
.error ul { margin: 0; padding-left: 20px; }
.success { background: #e5f6e8; border: 1px solid #5cb85c; color: #2d6a2d; padding: 8px 12px; border-radius: 4px; text-align: center; font-weight: bold; }
.info { text-align: center; color: #555; }
.muted { color: #777; font-style: italic; }
</style>
